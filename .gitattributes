# Normalize line endings to LF for text so diffs stay clean across Windows/Linux.
* text=auto eol=lf
*.py text eol=lf
*.html text eol=lf
*.js text eol=lf
*.css text eol=lf
*.md text eol=lf
*.json text eol=lf

# Binary assets must never be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
